rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(comercioId) {
      return exists(/databases/$(database)/documents/comercios/$(comercioId))
        && get(/databases/$(database)/documents/comercios/$(comercioId)).data.user_id == request.auth.uid;
    }

    // Comercios
    match /comercios/{comercioId} {
      allow read: if resource.data.activo == true;
      allow read, write: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Catálogos
    match /catalogos/{catalogoId} {
      allow read: if resource.data.activo == true;
      allow write: if request.auth != null && esDueno(resource.data.comercio_id);
      allow create: if request.auth != null && esDueno(request.resource.data.comercio_id);
    }

    // Categorías
    match /categorias/{categoriaId} {
      allow read: if resource.data.activo == true;
      allow write: if request.auth != null && esDueno(
        get(/databases/$(database)/documents/catalogos/$(resource.data.catalogo_id)).data.comercio_id
      );
      allow create: if request.auth != null && esDueno(
        get(/databases/$(database)/documents/catalogos/$(request.resource.data.catalogo_id)).data.comercio_id
      );
    }

    // Productos
    match /productos/{productoId} {
      allow read: if resource.data.disponible == true;
      allow write: if request.auth != null && esDueno(resource.data.comercio_id);
      allow create: if request.auth != null && esDueno(request.resource.data.comercio_id);
    }

    // Pedidos - lectura solo dueño, escritura pública (clientes sin login)
    match /pedidos/{pedidoId} {
      allow read: if request.auth != null && esDueno(resource.data.comercio_id);
      allow create: if exists(/databases/$(database)/documents/catalogos/$(request.resource.data.catalogo_id))
        && get(/databases/$(database)/documents/catalogos/$(request.resource.data.catalogo_id)).data.activo == true;
    }

    // Suscripciones - solo dueño lee, solo servidor escribe (webhook MP)
    match /suscripciones/{suscripcionId} {
      allow read: if request.auth != null && esDueno(resource.data.comercio_id);
      allow write: if false;
    }
  }
}
